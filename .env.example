# ==============================================================================
# DATABASE CONFIGURATION (Managed PostgreSQL)
# ==============================================================================
# On Blitz.cloud or other PaaS, connect your managed PostgreSQL database.
# Platform automatically injects DATABASE_URL into the application environment.
# FORMAT: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=prefer
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Local development connection string fallback (when DATABASE_URL is not set):
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=todolist_db;Username=postgres;Password=postgres

# ==============================================================================
# SECURITY & JWT CONFIGURATION
# ==============================================================================
# Generate a secure 64-character secret for production signing
JWT__Key=your_minimum_32_character_secure_random_jwt_secret_key_here_123456
JWT__Issuer=https://api.yourdomain.com
JWT__Audience=ToDoListClient
JWT__AccessTokenExpirationMinutes=60
JWT__RefreshTokenExpirationDays=7

# ==============================================================================
# EMAIL SERVICE (Brevo / SMTP Relay for OTP Delivery)
# ==============================================================================
# Blitz.cloud blocks standard outbound ports 25, 465, and 587.
# Brevo SMTP relay via port 2525 is verified and recommended.
Email__Host=smtp-relay.brevo.com
Email__Port=2525
Email__SmtpUsername=your_smtp_username@smtp-brevo.com
Email__SmtpPassword=your_smtp_key_or_password
Email__SenderEmail=noreply@yourdomain.com
Email__SenderDisplayName=ToDo & Notes App
Email__EnableSsl=true
Email__ExpirationMinutes=15

# ==============================================================================
# GOOGLE OAUTH CONFIGURATION (Optional - required if enabling Google Sign-In)
# ==============================================================================
# Authorized Redirect URI in Google Cloud Console:
# https://api.yourdomain.com/signin-google
Authentication__Google__ClientId=your_google_client_id_here
Authentication__Google__ClientSecret=your_google_client_secret_here

# ==============================================================================
# URLS & CORS CONFIGURATION
# ==============================================================================
# Public backend URL used to generate public image URLs:
BaseURL=https://api.yourdomain.com

# Allowed frontend origins for CORS (Vercel URL and local development):
Frontend__AllowedBaseUrls__0=https://your-app.vercel.app
Frontend__AllowedBaseUrls__1=http://localhost:5173
Frontend__AllowedBaseUrls__2=http://localhost:3000

# ==============================================================================
# HOSTING & PROXY
# ==============================================================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTPS_PORT=443
DOMAIN=api.yourdomain.com

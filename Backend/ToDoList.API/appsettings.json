{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BaseURL": "http://localhost:8080",
  "JWT": {
    "Key": "SuperSecretDevSigningKeyForToDoListAppMustBeAtLeast32CharsLong!",
    "Issuer": "ToDoListApp",
    "Audience": "ToDoListClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Email": {
    "Host": "smtp-relay.brevo.com",
    "Port": 2525,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "SenderEmail": "notifications@example.com",
    "SenderDisplayName": "ToDo & Notes",
    "EnableSsl": true,
    "ExpirationMinutes": 15
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Frontend": {
    "AllowedBaseUrls": [
      "http://localhost:5173",
      "http://localhost:3000",
      "https://todo-notes.vercel.app"
    ]
  },
  "LocalStorage": {
    "RootPath": "wwwroot",
    "FilesDirectory": "files",
    "MaxFileSizeBytes": 20971520
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=todolist_db;Username=postgres;Password=postgres"
  }
}
